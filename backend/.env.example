# PostgreSQL connection string.
# If not set, the app falls back to a local SQLite file (./vndly.db) so it
# runs out of the box for demos. For production/enterprise use, point this
# at a real PostgreSQL instance, e.g.:
# DATABASE_URL=postgresql+psycopg2://vndly_user:vndly_pass@localhost:5432/vndly_db
DATABASE_URL=postgresql+psycopg2://postgres:7861195@localhost:5432/wd

# JWT secret — change this in production
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1480

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
