# PostgreSQL connection string.
# If not set, the app falls back to a local SQLite file (./vndly.db) so it
# runs out of the box for demos. For production/enterprise use, point this
# at a real PostgreSQL instance, e.g.:
# DATABASE_URL=postgresql+psycopg2://vndly_user:vndly_pass@localhost:5432/vndly_db
DATABASE_URL=postgresql+psycopg2://vndly_user:vndly_pass@localhost:5432/vndly_db

# JWT secret — change this in production
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------------------
# Email notifications (assignment notices to contractors)
#
# Leave SMTP_HOST blank to keep email OFF: messages are written to
# backend/outbox.log instead of being sent, so the feature is demonstrable
# without credentials and cannot email anyone by accident.
#
# For Gmail use an App Password, not your account password.
# Never commit real credentials.
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
